            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "cond-expired",
              "leftValue": "={{ $json.needsRefresh }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "090f5ece-770b-4023-8062-e36dee31bdf6",
      "name": "IF_TokenIsExpired",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
